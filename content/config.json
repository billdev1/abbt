				"motherboard": "cat /sys/devices/virtual/dmi/id/board_name",
				"cpu": "grep -i \"model name\" /proc/cpuinfo | head -n 1 | cut -d: -f2",
				"mac": "ip link show | grep -i \"link/ether\" | awk '{print $2}' | head -n 1"
			}
		},
